{
  "name": "food-friend-api",
  "version": "1.0.0",
  "description": "",
  "author": "Oleksii Lavka",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "start:db": "docker compose up --build",
    "dev": "yarn start:db -d && yarn start:dev",
    "docker:down": "docker compose down --volumes",
    "start:debug": "nest start --debug --watch",
    "prisma:seed": "tsx src/infrastructure/database/prisma/seeds/seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --runInBand",
    "postinstall": "prisma generate",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns='docs-coverage.spec.ts'",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:docs": "jest --config ./test/jest-docs.json",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:docs && npm run test:e2e",
    "test:everything": "npm run test:all && npm run test:coverage:gate && npm run test:coverage:full",
    "test:coverage:gate": "jest --config ./jest.coverage-gate.json --coverage --runInBand",
    "test:coverage:full": "jest --config ./jest.coverage-full.json --coverage --runInBand",
    "openapi:generate": "node -r tsconfig-paths/register -r ts-node/register src/script/generate-openapi.script.ts",
    "ci:check": "npx prisma generate && npx tsc --noEmit && npx eslint \"{src,apps,libs,test}/**/*.ts\" && npm run test:all && npm run test:coverage:gate && npm run openapi:generate",
    "uuid-to-hash": "node dist/src/script/uuid-to-hash.script",
    "hash-to-uuid": "node dist/src/script/hash-to-uuid.script"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@react-email/components": "^0.5.0",
    "@types/multer": "^2.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "dotenv-expand": "^12.0.2",
    "google-auth-library": "^10.3.0",
    "html-react-parser": "^5.2.6",
    "ioredis": "^5.10.1",
    "meilisearch": "^0.58.0",
    "nestjs-i18n": "^10.5.1",
    "nodemailer": "^7.0.5",
    "openai": "^6.33.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "prisma": "^7.0.0",
    "qs": "^6.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.5.2",
    "rxjs": "^7.8.1",
    "ts-pattern": "^5.8.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/qs": "^6.14.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@access-control/(.*)$": "<rootDir>/access-control/$1",
      "^@core/(.*)$": "<rootDir>/core/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@localization$": "<rootDir>/infrastructure/localization",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@swagger/(.*)$": "<rootDir>/swagger/$1"
    },
    "collectCoverageFrom": [
      "common/util/language.util.ts",
      "common/util/normalize-value.util.ts",
      "core/background-job/service/background-job.service.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testEnvironment": "node"
  }
}
