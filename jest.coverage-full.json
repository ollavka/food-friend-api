{
  "moduleFileExtensions": ["js", "json", "ts", "tsx"],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@access-control/(.*)$": "<rootDir>/access-control/$1",
    "^@core/(.*)$": "<rootDir>/core/$1",
    "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
    "^@localization$": "<rootDir>/infrastructure/localization",
    "^@common/(.*)$": "<rootDir>/common/$1",
    "^@config/(.*)$": "<rootDir>/config/$1",
    "^@swagger/(.*)$": "<rootDir>/swagger/$1"
  },
  "collectCoverageFrom": [
    "**/*.ts",
    "!**/*.spec.ts",
    "!**/*.module.ts",
    "!**/*.docs.ts",
    "!**/*.dto.ts",
    "!**/*.api-model.ts",
    "!**/*.type.ts",
    "!**/index.ts",
    "!main.ts",
    "!core/recipe/service/**",
    "!core/product/service/**",
    "!core/search/service/**",
    "!core/shopping-list/service/**",
    "!infrastructure/meilisearch/service/**",
    "!infrastructure/ai/service/**",
    "!common/validation/**",
    "!swagger/decorator/**",
    "!common/exception/factory/**",
    "!common/filter/app-exception.filter.ts",
    "!config/app/app.config.ts",
    "!core/language/service/**",
    "!core/auth/guard/**",
    "!infrastructure/database/service/**",
    "!common/decorator/file-upload.decorator.ts",
    "!core/measurement-unit/repository/measurement-unit.repository.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "coverageDirectory": "../coverage/full",
  "testEnvironment": "node"
}
